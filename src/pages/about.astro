---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SOCIALS } from "@/consts";
import { Image } from "astro:assets";
import headshot from "@/assets/author/headshot.jpg";

const skills = [
  'Cloud & AI Solutions Architecture',
  'Azure AI Foundry & OpenAI',
  'Multi-Agent Systems & Swarm Orchestration',
  'Model Context Protocol (MCP)',
  'C# / .NET & Python',
  'Machine Learning Security (OWASP LLM)',
  'Data Pipelines & Vector Databases',
  'Zero-Trust Architecture & Identity',
  'DevOps & Infrastructure as Code (Bicep/Terraform)',
  'GitHub Copilot & AI Tooling',
]

const experience = [
  {
    role: 'Cloud Developer',
    company: 'Agency (Client Engagement through Vendor)',
    period: '2024 — Present',
    location: 'Remote / Hybrid',
    summary:
      'Developing and deploying enterprise cloud architectures, AI integrations, and backend microservices. Implementing automated ML privacy governance gates, Azure OpenAI endpoints, and robust data pipelines.',
  },
]
---

<BaseLayout
  title="About"
  description="About Nithin, Cloud Developer & AI Solutions Architect."
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <Image
        src={headshot}
        alt="Nithin"
        widths={[112, 224]}
        sizes="112px"
        class="h-28 w-28 shrink-0 rounded-2xl object-cover shadow-sm"
      />
      <div>
        <h1
          class="text-ink-900 text-3xl font-bold tracking-tight text-balance sm:text-4xl dark:text-white"
        >
          Nithin
        </h1>
        <p class="text-azure-600 dark:text-azure-400 mt-2 text-lg">
          Cloud Developer & AI Solutions Architect
        </p>
      </div>
    </div>

    <div class="prose prose-lg dark:prose-invert mt-10 max-w-none">
      <p>
        I'm a Cloud Developer & AI Solutions Architect with 2+ years of hands-on
        experience engineering resilient cloud applications, AI systems, and
        enterprise integrations.
      </p>
      <p>
        Working with client engagements through vendor agencies, I focus on
        Azure cloud architecture, AI privacy governance, Model Context Protocol
        (MCP), and LLM auditing. I specialize in building production-grade
        solutions with mathematical security guardrails and modern DevOps
        practices.
      </p>
      <p>
        This blog is where I document practical implementation blueprints,
        open-source tools, and lessons learned building software.
      </p>
    </div>

    <div class="mt-12">
      <h2 class="text-ink-900 text-xl font-semibold dark:text-white">
        Experience
      </h2>
      <p class="text-ink-500 dark:text-ink-400 mt-1 text-sm">
        2+ years delivering cloud engineering, AI integrations, and enterprise
        solutions
      </p>
      <ol
        class="border-ink-200 dark:border-ink-800 mt-6 space-y-8 border-l pl-6"
      >
        {
          experience.map(job => (
            <li class="relative">
              <span
                class="bg-azure-500 dark:ring-ink-950 absolute top-1.5 -left-[1.65rem] h-3 w-3 rounded-full ring-4 ring-white"
                aria-hidden="true"
              />
              <h3 class="text-ink-900 font-semibold dark:text-white">
                {job.role}
              </h3>
              <p class="text-azure-600 dark:text-azure-400 text-sm">
                {job.company} · {job.period}
              </p>
              <p class="text-ink-500 dark:text-ink-400 text-xs">
                {job.location}
              </p>
              <p class="text-ink-700 dark:text-ink-300 mt-2">{job.summary}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mt-12">
      <h2 class="text-ink-900 text-xl font-semibold dark:text-white">
        What I work with
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          skills.map(skill => (
            <li class="border-ink-200 text-ink-700 dark:border-ink-800 dark:bg-ink-900 dark:text-ink-200 rounded-lg border bg-white px-3 py-1.5 text-sm">
              {skill}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 flex flex-wrap gap-3">
      <a
        href={SOCIALS.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="border-ink-300 text-ink-700 hover:border-azure-400 hover:text-azure-600 dark:border-ink-700 dark:text-ink-200 dark:hover:border-azure-500 dark:hover:text-azure-400 inline-flex items-center gap-2 rounded-lg border px-5 py-3 text-sm font-semibold transition"
      >
        <svg
          class="h-5 w-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            d="M4.98 3.5A2.5 2.5 0 100 3.51 2.5 2.5 0 004.98 3.5zM.24 8.02h4.5V24H.24V8.02zM8.24 8.02h4.31v2.18h.06c.6-1.14 2.07-2.34 4.26-2.34C21.6 7.86 24 10.1 24 14.6V24h-4.5v-8.3c0-1.98-.04-4.52-2.76-4.52-2.76 0-3.18 2.16-3.18 4.38V24H8.24V8.02z"
          ></path></svg
        >
        Connect on LinkedIn
      </a>
      <a
        href={SOCIALS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="border-ink-300 text-ink-700 hover:border-azure-400 hover:text-azure-600 dark:border-ink-700 dark:text-ink-200 dark:hover:border-azure-500 dark:hover:text-azure-400 inline-flex items-center gap-2 rounded-lg border px-5 py-3 text-sm font-semibold transition"
      >
        <svg
          class="h-5 w-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.35 9.35 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.48A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"
          ></path></svg
        >
        Follow on GitHub
      </a>
    </div>
  </div>
</BaseLayout>
