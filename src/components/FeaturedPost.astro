---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import TagList from "./TagList.astro";
import { readingTimeLabel } from "@/utils/readingTime";
import { url as toUrl } from "@/utils/paths";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const url = toUrl(`/blog/${post.id}/`);
const readTime = readingTimeLabel(post.body);
const primaryTag = tags[0];
---

<article
  class="group border-ink-200 hover:border-azure-300 hover:shadow-azure-500/5 dark:border-ink-800 dark:bg-ink-900 dark:hover:border-azure-700 relative grid overflow-hidden rounded-3xl border bg-white transition hover:shadow-xl md:grid-cols-2"
>
  {
    heroImage ? (
      <a
        href={url}
        class="relative block overflow-hidden"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image
          src={heroImage}
          alt=""
          widths={[480, 768, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
          class="h-full min-h-64 w-full object-cover transition duration-300 group-hover:scale-105"
        />
      </a>
    ) : (
      <div
        class="from-azure-50 dark:from-ink-950 dark:to-ink-900 relative hidden min-h-64 flex-col justify-center overflow-hidden bg-gradient-to-br to-teal-50 p-8 md:flex"
        aria-hidden="true"
      >
        <div class="bg-grid absolute inset-0 opacity-60" />
        <div class="bg-azure-500/20 absolute -top-10 -right-10 h-40 w-40 rounded-full blur-3xl" />
        <div class="border-ink-200/70 dark:border-ink-700/70 dark:bg-ink-900/70 relative rounded-xl border bg-white/70 p-4 shadow-sm backdrop-blur">
          <div class="flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-red-400/70" />
            <span class="h-2.5 w-2.5 rounded-full bg-amber-400/70" />
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/70" />
          </div>
          <p class="text-ink-500 dark:text-ink-400 mt-3 font-mono text-sm">
            <span class="text-azure-600 dark:text-azure-400">~</span> read
            --topic
          </p>
          <p class="text-ink-800 dark:text-ink-100 mt-1 flex items-center font-mono text-lg font-semibold">
            {primaryTag ?? "field-notes"}
            <span class="bg-azure-500/70 ml-1 inline-block h-4 w-2 translate-y-px" />
          </p>
        </div>
      </div>
    )
  }

  <div class="flex flex-col justify-center gap-4 p-7 sm:p-9">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="bg-azure-600 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold text-white"
      >
        Featured
      </span>
      <div
        class="text-ink-500 dark:text-ink-400 flex items-center gap-2 text-xs font-medium"
      >
        <FormattedDate date={pubDate} />
        {readTime && <span aria-hidden="true">·</span>}
        {readTime && <span>{readTime}</span>}
        <span aria-hidden="true">·</span>
        <span class="inline-flex items-center gap-1 text-ink-600 dark:text-ink-300 font-medium">
          <svg class="h-3.5 w-3.5 text-azure-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span data-postcard-views data-path={toUrl(`/blog/${post.id}`)}>1</span> views
        </span>
      </div>
    </div>

    <h2
      class="text-ink-900 text-2xl font-bold tracking-tight text-balance sm:text-3xl dark:text-white"
    >
      <a href={url} class="after:absolute after:inset-0">{title}</a>
    </h2>

    <p class="text-ink-600 dark:text-ink-300 line-clamp-3">{description}</p>

    <TagList tags={tags} max={4} class="relative z-10 mt-1" />

    <span
      class="text-azure-600 dark:text-azure-400 mt-1 inline-flex items-center gap-1 text-sm font-semibold"
    >
      Read article
      <svg
        class="h-4 w-4 transition group-hover:translate-x-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </span>
  </div>
</article>
