---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { url } from "@/utils/paths";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}
const { project, headingLevel = 3 } = Astro.props;
const { title, summary, tech, repoUrl, liveUrl, image, imageAlt } =
  project.data;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article
  id={project.id}
  class="group border-ink-200 hover:border-azure-300 hover:shadow-azure-500/5 dark:border-ink-800 dark:bg-ink-900 dark:hover:border-azure-700 relative flex scroll-mt-24 flex-col overflow-hidden rounded-2xl border bg-white transition hover:shadow-lg"
>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? title}
        widths={[320, 480, 800]}
        sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6">
    <Heading class="text-ink-900 text-lg font-semibold dark:text-white">
      <a
        href={url(`/projects/${project.id}/`)}
        class="group-hover:text-azure-600 focus-visible:after:ring-azure-500 dark:group-hover:text-azure-400 transition after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:rounded-2xl focus-visible:after:ring-2"
      >
        {title}
      </a>
    </Heading>
    <p class="text-ink-600 dark:text-ink-300 flex-1 text-sm">{summary}</p>

    {
      tech.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {tech.map(t => (
            <li class="bg-ink-100 text-ink-600 dark:bg-ink-800 dark:text-ink-300 rounded-md px-2 py-0.5 font-mono text-xs">
              {t}
            </li>
          ))}
        </ul>
      )
    }

    <div class="relative z-10 mt-2 flex items-center gap-4 text-sm font-medium">
      {
        liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-azure-600 dark:text-azure-400 inline-flex items-center gap-1 hover:underline"
          >
            Live
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14 5h5v5m0-5L10 14M5 5v14h14"
              />
            </svg>
          </a>
        )
      }
      {
        repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-600 hover:text-azure-600 dark:text-ink-300 dark:hover:text-azure-400 inline-flex items-center gap-1"
          >
            <svg
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48l-.01-1.7c-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.57 2.34 1.12 2.91.86.09-.66.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.35 9.35 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.48A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"
              />
            </svg>
            Code
          </a>
        )
      }
    </div>
  </div>
</article>
