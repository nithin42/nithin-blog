---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import TagList from "@/components/TagList.astro";
import Comments from "@/components/Comments.astro";
import PostListItem from "@/components/PostListItem.astro";
import { AUTHOR } from "@/consts";
import { url } from "@/utils/paths";

interface Props {
  post: CollectionEntry<"blog">;
  readingTime: string;
  headings?: { depth: number; slug: string; text: string }[];
  relatedPosts?: CollectionEntry<"blog">[];
  olderPost?: CollectionEntry<"blog">;
  newerPost?: CollectionEntry<"blog">;
}

const {
  post,
  readingTime,
  headings = [],
  relatedPosts = [],
  olderPost,
  newerPost,
} = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags } =
  post.data;
const tableOfContents = headings.filter(heading => heading.depth === 2);

// A trailing parenthetical (e.g. "Title (Subtitle)") renders on its own line
// in the post heading, while `title` stays a single clean string everywhere
// else (metadata, cards, RSS). Titles without one are unaffected.
const titleMatch = title.match(/^(.*?)\s+(\(.*\))$/);
const titleMain = titleMatch ? titleMatch[1] : title;
const titleAside = titleMatch ? titleMatch[2] : null;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  image={heroImage}
  imageAlt={heroAlt ?? title}
  tags={tags}
>
  <div data-reading-progress-track class="sticky top-16 z-30 h-0.5 w-full">
    <div data-reading-progress class="bg-azure-600 dark:bg-azure-400 h-full">
    </div>
  </div>
  <div
    data-blog-article-container
    class="mx-auto max-w-3xl px-4 py-12 sm:px-6 xl:grid xl:max-w-6xl xl:grid-cols-[minmax(0,48rem)_16rem] xl:justify-center xl:gap-12"
  >
    <article data-blog-article class="min-w-0">
      <header class="mb-8">
        <a
          href={url('/blog/')}
          class="text-ink-500 hover:text-azure-600 dark:text-ink-400 dark:hover:text-azure-400 mb-6 inline-flex items-center gap-1 text-sm font-medium transition"
        >
          &larr; Back to blog
        </a>
        <h1
          class="text-ink-900 text-3xl font-bold tracking-tight text-balance sm:text-4xl dark:text-white"
        >
          {titleMain}
          {
            titleAside && (
              <span class="text-ink-500 dark:text-ink-400 mt-1 block text-2xl sm:text-3xl">
                {titleAside}
              </span>
            )
          }
        </h1>
        <div
          class="text-ink-500 dark:text-ink-400 mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
        >
          <FormattedDate date={pubDate} />
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime}</span>
          <span aria-hidden="true">&middot;</span>
          <span data-page-views class="inline-flex items-center gap-1 text-ink-600 dark:text-ink-300 font-medium">
            <span data-page-views-count>1</span> views
          </span>
          <span aria-hidden="true">&middot;</span>
          <span>
            By <a
              href={url('/about/')}
              rel="author"
              class="text-azure-600 dark:text-azure-400 font-medium hover:underline"
              >{AUTHOR.name}</a
            >
          </span>
          {
            updatedDate && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>
                  Updated <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }
        </div>
        <TagList tags={tags} max={4} class="mt-4" />

        {/* Mobile & Tablet Compact Metrics Bar */}
        <div class="border-ink-200 bg-ink-50/70 dark:border-ink-800 dark:bg-ink-900/50 mt-5 mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border px-4 py-2.5 text-xs xl:hidden">
          <div class="flex items-center gap-4">
            <span class="flex items-center gap-1.5 text-ink-600 dark:text-ink-300 font-medium">
              <svg class="h-4 w-4 text-azure-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span data-mobile-views-count>1</span> views
            </span>
            <span class="flex items-center gap-1.5 text-ink-600 dark:text-ink-300 font-medium">
              <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <a href="#comments-heading" class="hover:text-azure-500 transition">
                <span data-mobile-comments-count>0</span> comments
              </a>
            </span>
            <span class="flex items-center gap-1.5 text-ink-600 dark:text-ink-300 font-medium">
              <svg class="h-4 w-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readingTime}</span>
            </span>
          </div>
          <a
            href="#comments-heading"
            class="text-azure-600 dark:text-azure-400 font-semibold hover:underline"
          >
            Comment &rarr;
          </a>
        </div>
      </header>

      {
        heroImage && (
          <Image
            data-article-hero
            src={heroImage}
            alt={heroAlt ?? title}
            widths={[480, 768, 1200]}
            sizes="(min-width: 768px) 768px, calc(100vw - 2rem)"
            loading="eager"
            fetchpriority="high"
            class="mb-10 aspect-[16/9] w-full rounded-2xl object-cover shadow-sm ring-1 ring-ink-200/50 dark:ring-ink-800/50"
          />
        )
      }

      {
        tableOfContents.length >= 3 && (
          <nav
            aria-label="On this page"
            data-table-of-contents
            class="border-ink-200 bg-ink-50 dark:border-ink-800 dark:bg-ink-900 mb-10 rounded-xl border p-5 xl:hidden"
          >
            <p class="text-ink-900 text-sm font-semibold dark:text-white">
              On this page
            </p>
            <ol class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
              {tableOfContents.map(heading => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="text-ink-600 hover:text-azure-600 dark:text-ink-300 dark:hover:text-azure-400 inline-flex py-0.5 transition"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div
        class="prose prose-lg dark:prose-invert prose-headings:font-semibold prose-pre:rounded-xl prose-pre:border prose-pre:border-ink-200 dark:prose-pre:border-ink-800 prose-p:text-ink-800 dark:prose-p:text-ink-100 prose-li:text-ink-800 dark:prose-li:text-ink-100 prose-strong:text-ink-900 dark:prose-strong:text-white max-w-none"
      >
        <slot />
      </div>



      {
        relatedPosts.length > 0 && (
          <section
            class="border-ink-200/70 dark:border-ink-800/70 mt-16 border-t pt-10"
            aria-labelledby="related-posts-heading"
          >
            <h2
              id="related-posts-heading"
              class="text-ink-900 text-xl font-semibold dark:text-white"
            >
              Related articles
            </h2>
            <div class="divide-ink-200/70 dark:divide-ink-800/70 mt-4 divide-y">
              {relatedPosts.map(relatedPost => (
                <PostListItem post={relatedPost} />
              ))}
            </div>
          </section>
        )
      }

      {
        (olderPost || newerPost) && (
          <nav
            aria-label="More articles"
            class="border-ink-200/70 dark:border-ink-800/70 mt-12 grid gap-4 border-t pt-8 sm:grid-cols-2"
          >
            {olderPost ? (
              <a
                href={url(`/blog/${olderPost.id}/`)}
                class="border-ink-200 hover:border-azure-400 dark:border-ink-800 dark:hover:border-azure-600 rounded-xl border p-4 transition"
              >
                <span class="text-ink-500 dark:text-ink-400 block text-xs font-semibold tracking-wide uppercase">
                  Older article
                </span>
                <span class="text-ink-900 dark:text-ink-100 mt-1 block font-semibold">
                  {olderPost.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
            {newerPost ? (
              <a
                href={url(`/blog/${newerPost.id}/`)}
                class="border-ink-200 hover:border-azure-400 dark:border-ink-800 dark:hover:border-azure-600 rounded-xl border p-4 text-right transition"
              >
                <span class="text-ink-500 dark:text-ink-400 block text-xs font-semibold tracking-wide uppercase">
                  Newer article
                </span>
                <span class="text-ink-900 dark:text-ink-100 mt-1 block font-semibold">
                  {newerPost.data.title}
                </span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      <Comments postId={post.id} postTitle={title} />
    </article>

    {
      tableOfContents.length >= 3 && (
        <aside class="hidden xl:block" aria-label="Article outline">
          <div class="sticky top-24 space-y-6">
            <nav
              data-toc-rail
              class="max-h-[calc(100vh-22rem)] overflow-y-auto"
            >
              <p class="text-ink-500 dark:text-ink-400 text-xs font-semibold tracking-wide uppercase">
                On this page
              </p>
              <ul class="border-ink-200 dark:border-ink-800 mt-3 space-y-1 border-l">
                {tableOfContents.map(heading => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link={heading.slug}
                      class="text-ink-500 hover:text-azure-600 dark:text-ink-400 dark:hover:text-azure-400 -ml-px block border-l border-transparent py-1 pl-4 text-sm transition"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <div class="border-ink-200 bg-ink-50/70 dark:border-ink-800 dark:bg-ink-900/60 rounded-2xl border p-4 shadow-sm backdrop-blur-sm">
              <dl class="space-y-2.5 text-xs">
                <div class="flex items-center justify-between">
                  <dt class="text-ink-500 dark:text-ink-400 flex items-center gap-1.5 font-medium">
                    <svg class="h-4 w-4 text-azure-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span>Views</span>
                  </dt>
                  <dd class="font-semibold text-ink-900 dark:text-white" data-sidebar-views-count>
                    1
                  </dd>
                </div>
                <div class="flex items-center justify-between">
                  <dt class="text-ink-500 dark:text-ink-400 flex items-center gap-1.5 font-medium">
                    <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span>Comments</span>
                  </dt>
                  <dd class="font-semibold text-ink-900 dark:text-white">
                    <a href="#comments-heading" class="hover:text-azure-500 transition">
                      <span data-sidebar-comments-count>0</span>
                    </a>
                  </dd>
                </div>
                <div class="flex items-center justify-between">
                  <dt class="text-ink-500 dark:text-ink-400 flex items-center gap-1.5 font-medium">
                    <svg class="h-4 w-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Read time</span>
                  </dt>
                  <dd class="font-semibold text-ink-900 dark:text-white">
                    {readingTime}
                  </dd>
                </div>
                <div class="flex items-center justify-between">
                  <dt class="text-ink-500 dark:text-ink-400 flex items-center gap-1.5 font-medium">
                    <svg class="h-4 w-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Published</span>
                  </dt>
                  <dd class="font-medium text-ink-700 dark:text-ink-300 text-xs">
                    <FormattedDate date={pubDate} />
                  </dd>
                </div>
              </dl>
              <div class="mt-3.5 border-t border-ink-200/80 pt-3 dark:border-ink-800">
                <a
                  href="#comments-heading"
                  class="bg-azure-50 text-azure-700 hover:bg-azure-100 dark:bg-azure-950/60 dark:text-azure-300 dark:hover:bg-azure-900/60 flex w-full items-center justify-center gap-1.5 rounded-lg py-1.5 text-xs font-semibold transition"
                >
                  Join Discussion &rarr;
                </a>
              </div>
            </div>
          </div>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  // Highlights the outline entry for the section currently in view.
  let controller: AbortController | undefined;

  function initArticleChrome() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const article = document.querySelector<HTMLElement>("[data-blog-article]");
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    if (!article || links.length === 0) return;

    const activeClasses = [
      "text-azure-600",
      "dark:text-azure-400",
      "border-azure-600",
      "dark:border-azure-400",
      "font-medium",
    ];

    const setActive = (slug: string | null) => {
      for (const link of links) {
        const on = link.dataset.tocLink === slug;
        link.classList.toggle("border-transparent", !on);
        for (const cls of activeClasses) link.classList.toggle(cls, on);
        if (on) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };

    const headings = links
      .map(link =>
        document.getElementById(decodeURIComponent(link.dataset.tocLink ?? ""))
      )
      .filter((el): el is HTMLElement => el !== null);

    const update = () => {
      if (headings.length === 0) return;
      const offset = 120;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= offset) current = heading;
      }
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.offsetHeight - 4;
      setActive(atBottom ? headings[headings.length - 1].id : current.id);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true, signal });
    window.addEventListener("resize", onScroll, { passive: true, signal });
    update();

    // Fetch and display live page views
    const viewsCountEl = document.querySelector<HTMLElement>("[data-page-views-count]");
    const sidebarViewsEl = document.querySelector<HTMLElement>("[data-sidebar-views-count]");
    const mobileViewsEl = document.querySelector<HTMLElement>("[data-mobile-views-count]");
    if (viewsCountEl || sidebarViewsEl || mobileViewsEl) {
      const path = window.location.pathname.replace(/\/$/, "");
      fetch(`https://nithin-blog.goatcounter.com/counter/${encodeURIComponent(path)}.json`)
        .then(res => res.json())
        .then(data => {
          if (data && data.count) {
            if (viewsCountEl) viewsCountEl.textContent = data.count;
            if (sidebarViewsEl) sidebarViewsEl.textContent = data.count;
            if (mobileViewsEl) mobileViewsEl.textContent = data.count;
          }
        })
        .catch(() => {});
    }
  }

  initArticleChrome();
  document.addEventListener("astro:after-swap", initArticleChrome);
</script>
