---
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { ANALYTICS } from "@/consts";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: import("astro").ImageMetadata | string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  type,
  publishedTime,
  modifiedTime,
  tags,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
    />
    <ClientRouter />
    {ANALYTICS.enabled && ANALYTICS.goatcounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${ANALYTICS.goatcounterCode}.goatcounter.com/count`}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="bg-azure-700 fixed top-3 left-3 z-[70] -translate-y-20 rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-lg transition-transform focus-visible:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      function initGlobalViewsCounters() {
        const elements = document.querySelectorAll('[data-postcard-views][data-path]');
        elements.forEach(el => {
          const rawPath = el.getAttribute('data-path');
          if (!rawPath) return;
          const cleanPath = rawPath.replace(/\/$/, '');
          fetch(`https://nithin-blog.goatcounter.com/counter/${encodeURIComponent(cleanPath)}.json`)
            .then(res => res.json())
            .then(data => {
              if (data && data.count) {
                el.textContent = data.count;
              }
            })
            .catch(() => {});
        });
      }
      initGlobalViewsCounters();
      document.addEventListener('astro:page-load', initGlobalViewsCounters);
      document.addEventListener('astro:after-swap', initGlobalViewsCounters);
    </script>
  </body>
</html>
